    "test": "node scripts/run-tests.js",
    "test:e2e-first": "TEST_ORDER=e2e-first node scripts/run-tests.js",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.30.3",
  "type": "commonjs",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,json,md,cjs,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.575.0",
